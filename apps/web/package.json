{
  "name": "@tazor/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "serve": "node scripts/serve.mjs",
    "test:passkey": "NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_PAYMENT_MODULE=0x0000000000000000000000000000000000007000 NEXT_PUBLIC_APPROVER_ACCOUNT_FACTORY=0x0000000000000000000000000000000000007001 NEXT_PUBLIC_RELAYER_URL=http://relayer.test next build && playwright test passkey.spec.ts",
    "test:unit": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning tests/*.test.ts",
    "fixture:webauthn": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/webauthn-fixture.ts",
    "vector:approver": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/approver-vector.ts",
    "abi:sync": "node scripts/sync-abi.mjs",
    "test:e2e": "NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_PAYMENT_MODULE=0x0000000000000000000000000000000000007000 NEXT_PUBLIC_APPROVER_ACCOUNT_FACTORY=0x0000000000000000000000000000000000007001 NEXT_PUBLIC_RELAYER_URL=http://relayer.test next build && playwright test",
    "ipfs:car": "node scripts/ipfs-car.mjs",
    "build:ipfs": "NEXT_TELEMETRY_DISABLED=1 next build && node scripts/ipfs-car.mjs",
    "preview": "zsh scripts/preview.sh",
    "deploy:vercel": "NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ) next build && find dist/tazor-app -mindepth 1 -maxdepth 1 ! -name vercel.json ! -name .vercel -exec rm -rf {} + && cp -R out/. dist/tazor-app/ && cd dist/tazor-app && vercel deploy --prod --yes"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/tektur": "^5.3.0",
    "next": "16.4.5",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ipfs-car": "3.1.0",
    "typescript": "7.0.2"
  }
}

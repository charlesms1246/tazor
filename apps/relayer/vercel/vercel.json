{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.mjs"
    }
  ],
  "crons": [
    {
      "path": "/watch",
      "schedule": "0 3 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}

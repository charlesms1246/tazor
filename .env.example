# Copy to .env.local and fill in. Never commit real keys. All keys are testnet-only.
# Deployer / demo approvers (scripts)
PRIVATE_KEY=
PRIYA_KEY=
CFO_KEY=
RAVI_KEY=
MEERA_KEY=
# IPFS pinning (app build)
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=
# Relayer (apps/relayer); RELAYER_PRIVATE_KEY on the host pays WBT gas
RELAYER_KEY=
RELAYER_ADDRESS=
CRON_SECRET=
WC_RPC=https://rpc.testnet.whitechain.io
SEPOLIA_RPC=
SEPOLIA_PROOF_RPC=
RELAYER_DAILY_BUDGET_WBT=0.5
# Checkout, x402 and webhooks (all optional; defaults are the deployed testnet contracts)
CHECKOUT_ADDRESS=0x8Ce727e6B4099b68f667B1ffEcAd7e1BeB511670
DEPOSIT_CHECKOUT_ADDRESS=0xcb3515398C8Cd9459a1Dce75aB42ec664a07B3ab
X402_PAYTO=
# {"<merchant address lowercase>": {"url": "https://shop.example/webhooks", "secret": "whsec_..."}}
WEBHOOKS_JSON=
WEBHOOKS_DEMO_ALL=
# Upstash Redis REST, for webhook history shared across serverless instances
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Sandbox company (Autopilot counterparties, testnet only)
SANDBOX_ADMIN_KEY=
SANDBOX_RAVI_KEY=
SANDBOX_SUPPLIER_KEY=
SANDBOX_FINANCIER_KEY=
SANDBOX_OPERATOR_KEY=
